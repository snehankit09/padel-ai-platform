# Copy this file to .env.local and adjust as needed.
# .env.local is gitignored — never commit real values.

# Base URL of the backend API (see backend/.env.example's own default port).
# Must be prefixed NEXT_PUBLIC_ to be readable in the browser — Next.js
# only exposes env vars with that prefix to client-side code, everything
# else stays server-only by default.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional — client-side upload validation (Part 11c). Only set these if
# the backend's own MAX_UPLOAD_SIZE_MB / ALLOWED_VIDEO_FORMATS (see the
# repo root .env.example) were changed from their defaults; otherwise
# lib/config.ts already falls back to those same defaults (2048,
# "mp4,mov,avi") and these can stay unset.
# NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=2048
# NEXT_PUBLIC_ALLOWED_VIDEO_FORMATS=mp4,mov,avi

# Optional — mirror backend/.env's MAX_UPLOAD_SIZE_MB / ALLOWED_VIDEO_FORMATS
# here if you've changed either from Settings' defaults (2048, mp4,mov,avi).
# Used only for the client-side upload check in lib/validation.ts (Part
# 11c); the backend enforces its own values regardless, so an out-of-sync
# frontend value only makes that one check less accurate, not unsafe.
# NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=2048
# NEXT_PUBLIC_ALLOWED_VIDEO_FORMATS=mp4,mov,avi
