# Copy this file to .env and adjust as needed.
# .env is gitignored — never commit real secrets.

# --- App ---
APP_NAME=padel-ai-platform
ENVIRONMENT=development
DEBUG=true
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://padel:padel@postgres:5432/padel_ai

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Storage ---
# "local" for dev (writes to the storage/ folder), "s3" for production later
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/storage

# S3 settings (only used when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# --- Upload limits (PRD Module 1 acceptance criteria) ---
MAX_UPLOAD_SIZE_MB=2048
MAX_VIDEO_DURATION_MINUTES=120
ALLOWED_VIDEO_FORMATS=mp4,mov,avi

# --- Frame extraction (Part 5a) ---
FRAME_SAMPLE_RATE_FPS=5

# --- YOLO detection (Part 5b) ---
YOLO_MODEL_PATH=yolov8n.pt
YOLO_DEVICE=cpu

# --- Player & ball detection (Part 5d) ---
YOLO_PLAYER_CONFIDENCE_THRESHOLD=0.25
YOLO_BALL_CONFIDENCE_THRESHOLD=0.10

# --- Court detection & calibration (Part 5c) ---
COURT_LENGTH_M=20.0
COURT_WIDTH_M=10.0
COURT_CALIBRATION_MAX_FRAME_ATTEMPTS=5

# --- Player tracking (Part 6b) ---
PLAYER_TRACK_THRESH=0.6
PLAYER_TRACK_MATCH_THRESH_LOW=0.15
PLAYER_TRACK_IOU_THRESHOLD=0.3
PLAYER_TRACK_MAX_AGE=5
PLAYER_TRACK_MIN_HITS=2

# --- Rally boundary detection (Part 7a) ---
RALLY_ACTIVITY_GAP_TOLERANCE_FRAMES=8
RALLY_MIN_DURATION_FRAMES=5

# --- Serve detection (Part 7b) ---
SERVE_DETECTION_WINDOW_FRAMES=3
SERVE_MAX_BALL_PLAYER_DISTANCE_M=2.5
SERVE_MAX_BALL_PLAYER_DISTANCE_PX=150.0

# --- Shot classification (Part 7c) ---
SHOT_MAX_CONTACT_PLAYER_DISTANCE_M=2.5
SHOT_MAX_CONTACT_PLAYER_DISTANCE_PX=150.0
SHOT_SMASH_HEIGHT_RATIO=1.05
SHOT_LOB_MIN_AIRBORNE_FRAMES=6
SHOT_NET_PROXIMITY_M=3.0

# --- Point outcome detection (Part 7d) ---
POINT_OUTCOME_OUT_OF_BOUNDS_MARGIN_M=0.3
POINT_OUTCOME_NET_ZONE_M=1.0
POINT_OUTCOME_NET_DECELERATION_RATIO=0.35

# --- Pipeline retry (Part 4d) ---
PIPELINE_MAX_RETRIES=3
PIPELINE_RETRY_BACKOFF_SECONDS=10
PIPELINE_RETRY_BACKOFF_MAX_SECONDS=300
